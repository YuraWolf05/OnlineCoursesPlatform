CourseService --> EnrollmentRepository
CourseService --> ProgressRepository
CourseService --> UserRepository

AuthService --> UserRepository
AuthService --> CourseRepository

UserRepository --> User
CourseRepository --> Course
EnrollmentRepository --> Enrollment
ProgressRepository --> LessonProgress
CourseRepository --> Module
CourseRepository --> Lesson